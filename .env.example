# .env.example — скопируйте в .env и заполните своими значениями
# Все переменные необязательны: при отсутствии используются дефолты из config.py

# ─── GitHub ────────────────────────────────────────────────────────────────
# Персональный токен GitHub (Settings → Developer settings → Personal access tokens)
# Без токена модуль GitHub-сканирования будет пропущен.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# ─── Сеть ──────────────────────────────────────────────────────────────────
# Таймаут HTTP-запросов в секундах
REQUEST_TIMEOUT=10

# Максимальный размер скачиваемого файла (МБ)
MAX_MB=20

# Максимальное число одновременных HTTP-соединений
MAX_CONCURRENT=100

# ─── Google Dorks ──────────────────────────────────────────────────────────
# Сколько результатов запрашивать за один дорк
DORK_RESULTS_PER_QUERY=10

# Задержка между дорк-запросами (секунды), чтобы не получить бан
DORK_SLEEP=5

# ─── Логирование ───────────────────────────────────────────────────────────
# Уровень логов: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# URL ????? ????????? ??? ???????? CORS
FRONTEND_URL=http://localhost:5173
